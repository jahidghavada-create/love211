# Required locally and on Vercel. Replace these example values; do not commit .env.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
PROPOSAL_USERNAME=aashiyana
PROPOSAL_PASSWORD=replace-with-a-private-password
DATABASE_PATH=instance/proposal.sqlite3

# Local video setup only. Vercel uses FINAL_VIDEO_URL instead of local uploads.
VIDEO_SETUP_KEY=replace-with-a-private-video-setup-key

# Optional on Vercel: public HTTPS YouTube, Vimeo, or direct video URL.
# FINAL_VIDEO_URL=https://...
